# Server
PUBLIC_URL=http://localhost:1337
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS=
API_TOKEN_SALT=
JWT_SECRET=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SCHEMA=public

# R2 (EU jurisdiction: the endpoint has `.eu.`). One token scoped to both buckets.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com

# R2 backup (`<name>-backups`)
CRON_SCHEDULE=0 */6 * * *
S3_BUCKET=
# Key prefix the bucket's 3-day lifecycle rule expires
BACKUP_KEY_PREFIX=backup-

# R2 uploads (`<name>-files`, private, served from its CDN domain)
S3_UPLOAD_BUCKET=
S3_UPLOAD_PUBLIC_URL=
# Without S3_UPLOAD_BUCKET, production refuses to boot unless local disk is meant
UPLOAD_LOCAL=

# INTERNATIONALIZATION
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=fr

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=password

# SENTRY (production only; empty DSN keeps it off)
SENTRY_DSN=
# Release tag. Defaults to SOURCE_COMMIT (set by Coolify).
SENTRY_RELEASE=
