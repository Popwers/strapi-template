{
  "name": "strapi-template",
  "private": true,
  "version": "1.2.1",
  "description": "Strapi CMS",
  "scripts": {
    "prepare": "vp config --no-agent || true",
    "dev": "strapi develop",
    "start": "strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "test": "vp test",
    "gen:types": "strapi ts:generate-types --debug",
    "upgrade": "npx @strapi/upgrade latest",
    "test:e2e": "e2e run",
    "test:e2e:ci": "e2e run --exclude-tag agent --reporter list,junit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@strapi/data-transfer": "5.60.0",
    "@strapi/plugin-sentry": "5.60.0",
    "@strapi/plugin-users-permissions": "5.60.0",
    "@strapi/provider-email-nodemailer": "5.60.0",
    "@strapi/provider-upload-aws-s3": "5.60.0",
    "@strapi/strapi": "5.60.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sharp": "^0.35.5",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@ai-sdk/xai": "^5.0.30",
    "@e2e-dev/web": "^0.15.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "ai": "^7.0.153",
    "e2e": "^0.21.3",
    "react-doctor": "^0.9.18",
    "semantic-release": "^25.0.9",
    "typescript": "^5",
    "vite-plus": "^1.4.0"
  },
  "author": {
    "name": "Lionel Bataille"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": ""
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      [
        "@semantic-release/github",
        {
          "successComment": false
        }
      ]
    ]
  },
  "packageManager": "npm@10.9.9"
}
