{
  "name": "strapi-template",
  "private": true,
  "version": "1.0.1",
  "description": "Strapi CMS",
  "scripts": {
    "dev": "strapi develop",
    "start": "strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "test": "vp test",
    "gen:types": "strapi ts:generate-types --debug",
    "upgrade": "npx @strapi/upgrade latest",
    "e2e": "playwright test -c tests/e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@strapi/plugin-sentry": "5.56.0",
    "@strapi/plugin-users-permissions": "5.56.0",
    "@strapi/provider-email-nodemailer": "5.56.0",
    "@strapi/strapi": "5.56.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sharp": "^0.35.5",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "semantic-release": "^25.0.9",
    "typescript": "^5",
    "vite-plus": "^0.3.3"
  },
  "author": {
    "name": "Lionel Bataille"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": ""
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      [
        "@semantic-release/github",
        {
          "successComment": false
        }
      ]
    ]
  },
  "packageManager": "npm@10.9.3"
}
