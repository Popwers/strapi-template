{
  "feature": "admin-bootstrap",
  "baseUrl": "http://127.0.0.1:1341",
  "commands": [
    "verify-strapi http GET /admin/init",
    "verify-strapi screenshot --path proof/admin-bootstrap/wizard.png --url /admin",
    "verify-strapi http POST /admin/register-admin --json '{\"email\":\"verify-admin@example.com\",\"password\":\"VerifyAdmin1!\",\"firstname\":\"Verify\"}'",
    "verify-strapi http GET /admin/init",
    "verify-strapi http POST /admin/register-admin --json '{\"email\":\"second@example.com\",\"password\":\"VerifyAdmin1!\",\"firstname\":\"Second\",\"lastname\":\"Admin\"}'"
  ],
  "checks": [
    {
      "name": "init before",
      "hasAdmin": false,
      "pass": true
    },
    {
      "name": "register-admin without lastname",
      "status": 200,
      "keys": [
        "accessToken",
        "token",
        "user"
      ],
      "pass": true
    },
    {
      "name": "refresh cookie set",
      "cookie": "strapi_admin_refresh; path=/admin; samesite=lax; httponly",
      "pass": true
    },
    {
      "name": "init after",
      "hasAdmin": true,
      "pass": true
    },
    {
      "name": "second register-admin",
      "status": 400,
      "message": "You cannot register a new super admin",
      "pass": true
    },
    {
      "name": "wizard painted",
      "file": "wizard.png",
      "pass": true
    }
  ]
}
