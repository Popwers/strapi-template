{
  "feature": "users-register",
  "baseUrl": "http://127.0.0.1:1341",
  "commands": [
    "verify-strapi http POST /api/auth/local/register --json '{\"email\":\"verify-user@example.com\",\"password\":\"VerifyUser1!\"}'",
    "verify-strapi http POST /api/auth/local/register --json '{\"email\":\"verify-user-2@example.com\",\"password\":\"VerifyUser1!\",\"username\":\"i-picked-this\"}'",
    "verify-strapi http POST /api/auth/local/register --json '{\"email\":\"evil@example.com\",\"password\":\"VerifyUser1!\",\"role\":1}'",
    "verify-strapi http POST /api/auth/local/register --json '{\"email\":\"prov@example.com\",\"password\":\"VerifyUser1!\",\"provider\":\"local\"}'",
    "verify-strapi http POST /api/auth/local/register --json '{\"email\":\"verify-user@example.com\",\"password\":\"VerifyUser1!\"}'",
    "verify-strapi http POST /api/auth/local/register --json '{\"email\":\"Verify-Upper@Example.com\",\"password\":\"VerifyUser1!\"}'",
    "verify-strapi http GET /api/users/me --header 'Authorization: Bearer <jwt>'"
  ],
  "checks": [
    {
      "name": "happy path",
      "status": 200,
      "pass": true
    },
    {
      "name": "client username ignored",
      "status": 200,
      "pass": true
    },
    {
      "name": "role ignored",
      "status": 200,
      "pass": true
    },
    {
      "name": "provider ignored",
      "status": 200,
      "pass": true
    },
    {
      "name": "duplicate email",
      "status": 400,
      "message": "Email or Username are already taken",
      "pass": true
    },
    {
      "name": "email lowercased",
      "email": "verify-upper@example.com",
      "pass": true
    },
    {
      "name": "users/me matches first register",
      "status": 200,
      "pass": true
    }
  ]
}
