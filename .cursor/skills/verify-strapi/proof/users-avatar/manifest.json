{
  "feature": "users-avatar",
  "baseUrl": "http://127.0.0.1:1341",
  "commands": [
    "verify-strapi http POST /api/users/avatar --form 'files.avatar=@.cursor/skills/verify-strapi/fixtures/avatar.png'",
    "verify-strapi http POST /api/users/avatar --header 'Authorization: Bearer <jwt>' --form 'files.avatar=@.cursor/skills/verify-strapi/fixtures/avatar.png'",
    "verify-strapi http PUT /users-permissions/roles/1 --header 'Authorization: Bearer <admin token>' --json '<role with user.updateAvatar and user.update enabled>'",
    "verify-strapi http POST /api/users/avatar --header 'Authorization: Bearer <jwt>' --form 'files.avatar=@.cursor/skills/verify-strapi/fixtures/avatar.png'",
    "verify-strapi http GET '/api/users/me?populate=avatar' --header 'Authorization: Bearer <jwt>'",
    "verify-strapi http GET /api/users/me --header 'Authorization: Bearer <jwt>'",
    "verify-strapi http POST /api/users/avatar --header 'Authorization: Bearer <jwt>' --form 'avatar=@.cursor/skills/verify-strapi/fixtures/avatar.png'",
    "verify-strapi http POST /api/users/avatar --header 'Authorization: Bearer <jwt>' --form 'files.avatar=@.cursor/skills/verify-strapi/fixtures/avatar.png'",
    "verify-strapi http GET <first avatar url>",
    "verify-strapi http POST /upload --header 'Authorization: Bearer <admin token>' --form 'files=@bad.svg'",
    "verify-strapi http POST /api/users/avatar --header 'Authorization: Bearer <jwt>' --form 'files.avatar=@bad.svg'",
    "verify-strapi http POST /api/users/avatar --header 'Authorization: Bearer <jwt>' --form 'files.avatar=@note.txt'"
  ],
  "checks": [
    {
      "name": "anonymous",
      "status": 403,
      "pass": true
    },
    {
      "name": "before grant",
      "status": 403,
      "pass": true
    },
    {
      "name": "grant",
      "status": 200,
      "body": {
        "ok": true
      },
      "pass": true
    },
    {
      "name": "upload",
      "status": 200,
      "pass": true
    },
    {
      "name": "populate avatar",
      "documentId": "jb3qnkbfkzpglxlps00pa9l5",
      "pass": true
    },
    {
      "name": "me omits avatar",
      "pass": true
    },
    {
      "name": "wrong field",
      "status": 400,
      "message": "No avatar provided",
      "pass": true
    },
    {
      "name": "replace",
      "from": "jb3qnkbfkzpglxlps00pa9l5",
      "to": "etgrfwx8he97g9htn0lg7qca",
      "pass": true
    },
    {
      "name": "first file gone",
      "status": 404,
      "pass": true
    },
    {
      "name": "POST /upload refuses svg",
      "status": 400,
      "message": "File type 'image/svg+xml' is not allowed",
      "pass": true
    },
    {
      "name": "product gap: avatar route stores svg",
      "mime": "image/svg+xml",
      "pass": true
    },
    {
      "name": "product gap: avatar route stores txt",
      "mime": "text/plain",
      "pass": true
    }
  ]
}
